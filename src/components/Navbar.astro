---
---
<header class="bg-white border-b border-slate-200 sticky top-0 z-50">
  <div class="max-w-7xl mx-auto px-4 py-3 flex items-center justify-between gap-4">
    <a href="/" class="text-xl font-bold text-emerald-600 tracking-tight shrink-0">
      LandlordFormKit<span class="text-slate-800">.com</span>
    </a>

    <!-- All 10 Links Directly in Upper Menu Bar with " | " Partitions -->
    <nav class="hidden md:flex flex-wrap items-center justify-end gap-y-1 text-xs lg:text-sm font-medium text-slate-600">
      <a href="/" class="px-1.5 py-1 hover:text-emerald-600 transition">Rent Receipt</a>
      <span class="text-slate-300 select-none"> | </span>
      <a href="/lease-agreement" class="px-1.5 py-1 hover:text-emerald-600 transition">Lease Agreement</a>
      <span class="text-slate-300 select-none"> | </span>
      <a href="/rental-application" class="px-1.5 py-1 hover:text-emerald-600 transition">Rental Application</a>
      <span class="text-slate-300 select-none"> | </span>
      <a href="/security-deposit" class="px-1.5 py-1 hover:text-emerald-600 transition">Deposit Return</a>
      <span class="text-slate-300 select-none"> | </span>
      <a href="/cap-rate-calculator" class="px-1.5 py-1 hover:text-emerald-600 transition">Cap Rate Calc</a>
      <span class="text-slate-300 select-none"> | </span>
      <a href="/rental-cash-flow" class="px-1.5 py-1 hover:text-emerald-600 transition">Cash Flow & ROI</a>
      <span class="text-slate-300 select-none"> | </span>
      <a href="/rent-affordability" class="px-1.5 py-1 hover:text-emerald-600 transition">Rent Affordability</a>
      <span class="text-slate-300 select-none"> | </span>
      <a href="/rent-vs-buy" class="px-1.5 py-1 hover:text-emerald-600 transition">Rent vs. Buy</a>
      <span class="text-slate-300 select-none"> | </span>
      <a href="/late-rent-notice" class="px-1.5 py-1 hover:text-emerald-600 transition">Late Rent Notice</a>
      <span class="text-slate-300 select-none"> | </span>
      <a href="/inspection-checklist" class="px-1.5 py-1 hover:text-emerald-600 transition">Inspection Checklist</a>
    </nav>

    <!-- Mobile Hamburger Button -->
    <button id="mobileMenuBtn" aria-label="Toggle Menu"
      class="md:hidden p-2 rounded-lg text-slate-700 hover:bg-slate-100 focus:outline-none cursor-pointer">
      <svg id="menuIconOpen" class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
      </svg>
      <svg id="menuIconClose" class="w-6 h-6 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>
  </div>

  <!-- Mobile Dropdown Menu -->
  <div id="mobileMenu" class="hidden md:hidden bg-white border-t border-slate-200 px-4 pt-3 pb-5 shadow-lg">
    <p class="text-[11px] font-bold uppercase tracking-wider text-slate-400 mb-2">All Landlord & Real Estate Tools</p>
    <div class="grid grid-cols-1 divide-y divide-slate-100 text-sm font-medium text-slate-700">
      <a href="/" class="py-2.5 hover:text-emerald-600">Monthly Rent Receipt</a>
      <a href="/lease-agreement" class="py-2.5 hover:text-emerald-600">Residential Lease Agreement</a>
      <a href="/rental-application" class="py-2.5 hover:text-emerald-600">Tenant Rental Application</a>
      <a href="/security-deposit" class="py-2.5 hover:text-emerald-600">Security Deposit Return</a>
      <a href="/cap-rate-calculator" class="py-2.5 hover:text-emerald-600">Cap Rate & NOI Calculator</a>
      <a href="/rental-cash-flow" class="py-2.5 hover:text-emerald-600">Rental Cash Flow & ROI</a>
      <a href="/rent-affordability" class="py-2.5 hover:text-emerald-600">Rent Affordability Calculator</a>
      <a href="/rent-vs-buy" class="py-2.5 hover:text-emerald-600">Rent vs. Buy Calculator</a>
      <a href="/late-rent-notice" class="py-2.5 hover:text-emerald-600">Late Rent Notice Generator</a>
      <a href="/inspection-checklist" class="py-2.5 hover:text-emerald-600">Move-In / Move-Out Checklist</a>
    </div>
  </div>
</header>

<script src="../scripts/mobileMenu.js"></script>
