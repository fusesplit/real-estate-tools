---
import BaseLayout from '../layouts/BaseLayout.astro';
import AdSlot from '../components/AdSlot.astro';
---

<BaseLayout
  title="Free Rent vs. Buy Home Calculator with PDF Report | LandlordFormKit"
  description="Compare the true multi-year cost of renting versus buying a home including rent increases, mortgage interest, and home appreciation."
>
  <div class="text-center max-w-3xl mx-auto mb-6">
    <h1 class="text-3xl md:text-4xl font-extrabold text-slate-900 mb-3">
      Free Rent vs. Buy Home Calculator
    </h1>
    <p class="text-slate-600 text-base md:text-lg">
      Compare total rent payments against home equity and ownership costs over your planned stay.
    </p>
  </div>

  <AdSlot label="Sponsored" />

  <div class="bg-white rounded-2xl shadow-sm border border-slate-200 p-6 md:p-8 grid grid-cols-1 lg:grid-cols-12 gap-8">
    <div class="lg:col-span-6 space-y-4">
      <div class="grid grid-cols-2 gap-4">
        <div>
          <label class="block text-xs font-semibold text-slate-700 mb-1">Currency</label>
          <select id="currency" class="w-full rounded-lg border-slate-300 border p-2.5 text-sm">
            <option value="$" selected>USD ($)</option>
            <option value="£">GBP (£)</option>
            <option value="€">EUR (€)</option>
            <option value="CA$">CAD (CA$)</option>
            <option value="A$">AUD (A$)</option>
          </select>
        </div>
        <div>
          <label class="block text-xs font-semibold text-slate-700 mb-1">Years You Plan to Stay</label>
          <input type="number" id="yearsStay" value="7" min="1" max="30" class="w-full rounded-lg border-slate-300 border p-2.5 text-sm" />
        </div>
      </div>

      <div class="grid grid-cols-2 gap-4">
        <div>
          <label class="block text-xs font-semibold text-slate-700 mb-1">Current Monthly Rent</label>
          <input type="number" id="monthlyRent" value="2200" step="50" class="w-full rounded-lg border-slate-300 border p-2.5 text-sm" />
        </div>
        <div>
          <label class="block text-xs font-semibold text-slate-700 mb-1">Annual Rent Increase (%)</label>
          <input type="number" id="rentIncrease" value="3.5" step="0.5" class="w-full rounded-lg border-slate-300 border p-2.5 text-sm" />
        </div>
      </div>

      <div class="grid grid-cols-3 gap-3">
        <div>
          <label class="block text-xs font-semibold text-slate-700 mb-1">Home Price</label>
          <input type="number" id="homePrice" value="400000" step="5000" class="w-full rounded-lg border-slate-300 border p-2.5 text-sm" />
        </div>
        <div>
          <label class="block text-xs font-semibold text-slate-700 mb-1">Down Payment</label>
          <input type="number" id="downPayment" value="80000" step="5000" class="w-full rounded-lg border-slate-300 border p-2.5 text-sm" />
        </div>
        <div>
          <label class="block text-xs font-semibold text-slate-700 mb-1">Mortgage Rate (%)</label>
          <input type="number" id="mortgageRate" value="6.5" step="0.1" class="w-full rounded-lg border-slate-300 border p-2.5 text-sm" />
        </div>
      </div>
    </div>

    <div class="lg:col-span-6 bg-slate-50 rounded-xl p-6 border border-slate-200 flex flex-col justify-between">
      <div>
        <span class="text-xs font-bold uppercase tracking-wider text-emerald-600">Financial Verdict</span>
        <div id="verdictDisplay" class="text-3xl md:text-4xl font-extrabold text-slate-900 mt-1 mb-6">
          Buying saves $42,190.00
        </div>

        <div class="space-y-2.5 border-t border-slate-200 pt-4 text-sm">
          <div class="flex justify-between">
            <span class="text-slate-600">Total Rent Paid:</span>
            <strong id="totalRentDisplay" class="text-rose-600">$205,400.00</strong>
          </div>
          <div class="flex justify-between">
            <span class="text-slate-600">Net Unrecoverable Cost of Buying:</span>
            <strong id="netBuyDisplay" class="text-emerald-600">$163,210.00</strong>
          </div>
          <div class="flex justify-between">
            <span class="text-slate-600">Est. Future Home Value (3%/yr):</span>
            <strong id="futureValueDisplay" class="text-slate-900">$491,949.55</strong>
          </div>
        </div>
      </div>

      <div class="mt-8">
        <button id="downloadPdfBtn"
          class="w-full bg-emerald-600 hover:bg-emerald-700 text-white font-bold py-3.5 px-6 rounded-xl shadow-sm transition cursor-pointer">
          Download Rent vs. Buy PDF Report
        </button>
      </div>
    </div>
  </div>

  <AdSlot label="Sponsored" />
</BaseLayout>

<script src="../scripts/rentVsBuy.js"></script>
