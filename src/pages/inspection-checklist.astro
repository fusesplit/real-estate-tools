---
import BaseLayout from '../layouts/BaseLayout.astro';
import AdSlot from '../components/AdSlot.astro';
---

<BaseLayout
  title="Free Move-In / Move-Out Rental Inspection Checklist (PDF) | LandlordFormKit"
  description="Generate a printable room-by-room rental property inspection checklist PDF for tenant move-in and move-out walk-throughs."
>
  <div class="text-center max-w-3xl mx-auto mb-6">
    <h1 class="text-3xl md:text-4xl font-extrabold text-slate-900 mb-3">
      Move-In / Move-Out Inspection Checklist
    </h1>
    <p class="text-slate-600 text-base md:text-lg">
      Document room-by-room property condition with landlord and tenant signature lines to prevent security deposit disputes.
    </p>
  </div>

  <AdSlot label="Sponsored" />

  <div class="bg-white rounded-2xl shadow-sm border border-slate-200 p-6 md:p-8 max-w-4xl mx-auto space-y-5">
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
      <div>
        <label class="block text-xs font-semibold text-slate-700 mb-1">Inspection Type</label>
        <select id="inspectionType" class="w-full rounded-lg border-slate-300 border p-2.5 text-sm">
          <option value="Move-In" selected>Move-In Inspection</option>
          <option value="Move-Out">Move-Out Inspection</option>
        </select>
      </div>
      <div>
        <label class="block text-xs font-semibold text-slate-700 mb-1">Inspection Date</label>
        <input type="date" id="inspectionDate" value="2026-11-20" class="w-full rounded-lg border-slate-300 border p-2.5 text-sm" />
      </div>
      <div>
        <label class="block text-xs font-semibold text-slate-700 mb-1">Property Address</label>
        <input type="text" id="propertyAddress" placeholder="Rental property address" class="w-full rounded-lg border-slate-300 border p-2.5 text-sm" />
      </div>
    </div>

    <div class="grid grid-cols-2 gap-4">
      <div>
        <label class="block text-xs font-semibold text-slate-700 mb-1">Landlord Name</label>
        <input type="text" id="landlordName" placeholder="Landlord Name" class="w-full rounded-lg border-slate-300 border p-2.5 text-sm" />
      </div>
      <div>
        <label class="block text-xs font-semibold text-slate-700 mb-1">Tenant Name</label>
        <input type="text" id="tenantName" placeholder="Tenant Name" class="w-full rounded-lg border-slate-300 border p-2.5 text-sm" />
      </div>
    </div>

    <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 pt-2">
      <div>
        <label class="block text-xs font-semibold text-slate-700 mb-1">Kitchen</label>
        <select id="kitchenStatus" class="w-full rounded-lg border-slate-300 border p-2 text-sm">
          <option value="Good / Clean" selected>Good / Clean</option>
          <option value="Minor Wear">Minor Wear</option>
          <option value="Needs Repair">Needs Repair</option>
        </select>
      </div>
      <div>
        <label class="block text-xs font-semibold text-slate-700 mb-1">Living Room</label>
        <select id="livingStatus" class="w-full rounded-lg border-slate-300 border p-2 text-sm">
          <option value="Good / Clean" selected>Good / Clean</option>
          <option value="Minor Wear">Minor Wear</option>
          <option value="Needs Repair">Needs Repair</option>
        </select>
      </div>
      <div>
        <label class="block text-xs font-semibold text-slate-700 mb-1">Bedrooms</label>
        <select id="bedroomStatus" class="w-full rounded-lg border-slate-300 border p-2 text-sm">
          <option value="Good / Clean" selected>Good / Clean</option>
          <option value="Minor Wear">Minor Wear</option>
          <option value="Needs Repair">Needs Repair</option>
        </select>
      </div>
      <div>
        <label class="block text-xs font-semibold text-slate-700 mb-1">Bathrooms</label>
        <select id="bathroomStatus" class="w-full rounded-lg border-slate-300 border p-2 text-sm">
          <option value="Good / Clean" selected>Good / Clean</option>
          <option value="Minor Wear">Minor Wear</option>
          <option value="Needs Repair">Needs Repair</option>
        </select>
      </div>
    </div>

    <div>
      <label class="block text-xs font-semibold text-slate-700 mb-1">Inspection Notes / Pre-Existing Wear</label>
      <textarea id="notes" rows="3" placeholder="e.g. Small scuff mark on living room baseboard; all appliances tested and working."
        class="w-full rounded-lg border-slate-300 border p-2.5 text-sm"></textarea>
    </div>

    <button id="downloadPdfBtn"
      class="w-full bg-emerald-600 hover:bg-emerald-700 text-white font-bold py-3.5 px-6 rounded-xl shadow-sm transition cursor-pointer">
      Download Printable Inspection Checklist PDF
    </button>
  </div>

  <AdSlot label="Sponsored" />
</BaseLayout>

<script src="../scripts/inspectionChecklist.js"></script>
