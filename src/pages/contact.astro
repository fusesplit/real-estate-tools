---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Contact Us | CalcMyLoan"
  description="Have a question, feedback, or calculator suggestion? Get in touch with the CalcMyLoan team."
>
  <div class="bg-white rounded-2xl border border-slate-200 p-6 md:p-10 max-w-2xl mx-auto space-y-6">
    <div>
      <h1 class="text-3xl font-extrabold text-slate-900 mb-2">Contact Us</h1>
      <p class="text-slate-600">
        Have a question about one of our calculators, found a bug, or want to suggest a new financial tool? Send us a message below.
      </p>
    </div>

    <div class="p-4 rounded-xl bg-blue-50 border border-blue-100 text-sm text-slate-700">
      <p><strong>Direct Email:</strong> <a href="mailto:support@calcmyloan.com" class="text-blue-600 font-semibold underline">support@calcmyloan.com</a></p>
      <p class="mt-1 text-slate-500">We typically respond to all inquiries within 24 to 48 business hours.</p>
    </div>

    <form action="mailto:support@calcmyloan.com" method="post" enctype="text/plain" class="space-y-4">
      <div>
        <label class="block text-sm font-semibold text-slate-700 mb-1">Your Name</label>
        <input type="text" name="name" required placeholder="John Doe"
          class="w-full rounded-lg border-slate-300 border p-2.5 text-slate-800 focus:ring-2 focus:ring-blue-500 outline-none" />
      </div>

      <div>
        <label class="block text-sm font-semibold text-slate-700 mb-1">Email Address</label>
        <input type="email" name="email" required placeholder="john@example.com"
          class="w-full rounded-lg border-slate-300 border p-2.5 text-slate-800 focus:ring-2 focus:ring-blue-500 outline-none" />
      </div>

      <div>
        <label class="block text-sm font-semibold text-slate-700 mb-1">Message</label>
        <textarea name="message" rows="4" required placeholder="How can we help you?"
          class="w-full rounded-lg border-slate-300 border p-2.5 text-slate-800 focus:ring-2 focus:ring-blue-500 outline-none"></textarea>
      </div>

      <button type="submit"
        class="w-full bg-blue-600 hover:bg-blue-700 text-white font-bold py-3 px-6 rounded-xl shadow-sm transition cursor-pointer">
        Send Message
      </button>
    </form>
  </div>
</BaseLayout>