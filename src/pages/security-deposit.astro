---
import BaseLayout from '../layouts/BaseLayout.astro';
import AdSlot from '../components/AdSlot.astro';
---

<BaseLayout
  title="Free Security Deposit Return Letter & Itemized Statement | LandlordFormKit"
  description="Generate a legally compliant itemized security deposit deduction statement and refund letter PDF for moving-out tenants."
>
  <div class="text-center max-w-3xl mx-auto mb-6">
    <h1 class="text-3xl md:text-4xl font-extrabold text-slate-900 mb-3">
      Security Deposit Return & Itemized Statement
    </h1>
    <p class="text-slate-600 text-base md:text-lg">
      Calculate deposit deductions for repairs or cleaning and generate an official move-out refund PDF.
    </p>
  </div>

  <AdSlot label="Sponsored" />

  <div class="bg-white rounded-2xl shadow-sm border border-slate-200 p-6 md:p-8 grid grid-cols-1 lg:grid-cols-12 gap-8">
    <div class="lg:col-span-7 space-y-4">
      <div class="grid grid-cols-3 gap-3">
        <div>
          <label class="block text-xs font-semibold text-slate-700 mb-1">Currency</label>
          <select id="currency" class="w-full rounded-lg border-slate-300 border p-2.5 text-sm">
            <option value="$" selected>USD ($)</option>
            <option value="£">GBP (£)</option>
            <option value="€">EUR (€)</option>
            <option value="CA$">CAD (CA$)</option>
            <option value="A$">AUD (A$)</option>
          </select>
        </div>
        <div>
          <label class="block text-xs font-semibold text-slate-700 mb-1">Original Deposit</label>
          <input type="number" id="initialDeposit" value="2000" step="50" class="w-full rounded-lg border-slate-300 border p-2.5 text-sm" />
        </div>
        <div>
          <label class="block text-xs font-semibold text-slate-700 mb-1">Move-Out Date</label>
          <input type="date" id="moveOutDate" value="2026-11-30" class="w-full rounded-lg border-slate-300 border p-2.5 text-sm" />
        </div>
      </div>

      <div class="grid grid-cols-2 gap-4">
        <div>
          <label class="block text-xs font-semibold text-slate-700 mb-1">Tenant Name</label>
          <input type="text" id="tenantName" placeholder="Tenant Name" class="w-full rounded-lg border-slate-300 border p-2.5 text-sm" />
        </div>
        <div>
          <label class="block text-xs font-semibold text-slate-700 mb-1">Landlord Name</label>
          <input type="text" id="landlordName" placeholder="Landlord Name" class="w-full rounded-lg border-slate-300 border p-2.5 text-sm" />
        </div>
      </div>

      <div>
        <label class="block text-xs font-semibold text-slate-700 mb-1">Property Address</label>
        <input type="text" id="propertyAddress" placeholder="Rental property address" class="w-full rounded-lg border-slate-300 border p-2.5 text-sm" />
      </div>

      <div class="pt-2 space-y-3">
        <p class="text-xs font-bold uppercase text-slate-500">Itemized Deductions (Leave $0 if none)</p>
        <div class="grid grid-cols-3 gap-3">
          <input type="text" id="ded1Desc" value="Wall Drywall & Paint Repair" class="col-span-2 rounded-lg border-slate-300 border p-2 text-sm" />
          <input type="number" id="ded1Amt" value="150" step="10" class="rounded-lg border-slate-300 border p-2 text-sm" />
        </div>
        <div class="grid grid-cols-3 gap-3">
          <input type="text" id="ded2Desc" placeholder="Additional Deduction Reason" class="col-span-2 rounded-lg border-slate-300 border p-2 text-sm" />
          <input type="number" id="ded2Amt" value="0" step="10" class="rounded-lg border-slate-300 border p-2 text-sm" />
        </div>
        <div class="grid grid-cols-3 gap-3">
          <input type="text" id="ded3Desc" placeholder="Additional deduction reason #3" class="col-span-2 rounded-lg border-slate-300 border p-2 text-sm" />
          <input type="number" id="ded3Amt" value="0" step="10" class="rounded-lg border-slate-300 border p-2 text-sm" />
        </div>
        <div class="grid grid-cols-3 gap-3">
          <input type="text" id="ded4Desc" placeholder="Additional deduction reason #4" class="col-span-2 rounded-lg border-slate-300 border p-2 text-sm" />
          <input type="number" id="ded4Amt" value="0" step="10" class="rounded-lg border-slate-300 border p-2 text-sm" />
        </div>
        <div class="grid grid-cols-3 gap-3">
          <input type="text" id="ded5Desc" placeholder="Additional deduction reason #5" class="col-span-2 rounded-lg border-slate-300 border p-2 text-sm" />
          <input type="number" id="ded5Amt" value="0" step="10" class="rounded-lg border-slate-300 border p-2 text-sm" />
        </div>
      </div>
    </div>

    <div class="lg:col-span-5 bg-slate-50 rounded-xl p-6 border border-slate-200 flex flex-col justify-between">
      <div>
        <span class="text-xs font-bold uppercase tracking-wider text-emerald-600">Net Refund Due to Tenant</span>
        <div id="refundDisplay" class="text-4xl font-extrabold text-slate-900 mt-1 mb-5">
          $1,730.00
        </div>

        <div class="space-y-2.5 border-t border-slate-200 pt-4 text-sm">
          <div class="flex justify-between">
            <span class="text-slate-600">Total Deductions:</span>
            <strong id="totalDeductionsDisplay" class="text-rose-600">$270.00</strong>
          </div>
          <div class="flex justify-between">
            <span class="text-slate-600">Balance Owed by Tenant:</span>
            <strong id="balanceOwedDisplay" class="text-slate-900">$0.00</strong>
          </div>
        </div>
      </div>

      <div class="mt-8">
        <button id="downloadPdfBtn"
          class="w-full bg-emerald-600 hover:bg-emerald-700 text-white font-bold py-3.5 px-6 rounded-xl shadow-sm transition cursor-pointer">
          Download Itemized Statement PDF
        </button>
      </div>
    </div>
  </div>

  <AdSlot label="Sponsored" />
</BaseLayout>

<script src="../scripts/securityDeposit.js"></script>
