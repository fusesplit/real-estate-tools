---
import BaseLayout from '../layouts/BaseLayout.astro';
import AdSlot from '../components/AdSlot.astro';
---

<BaseLayout
  title="Free Residential Lease Agreement Generator (PDF) | LandlordFormKit"
  description="Create a printable residential lease agreement PDF for fixed-term or month-to-month rentals. Free, customizable, and no signup required."
>
  <div class="text-center max-w-3xl mx-auto mb-6">
    <h1 class="text-3xl md:text-4xl font-extrabold text-slate-900 mb-3">
      Free Residential Lease Agreement Builder
    </h1>
    <p class="text-slate-600 text-base md:text-lg">
      Customize your rental terms, deposit, and pet policy, then download a ready-to-sign PDF lease contract.
    </p>
  </div>

  <AdSlot label="Sponsored" />

  <div class="bg-white rounded-2xl shadow-sm border border-slate-200 p-6 md:p-8 grid grid-cols-1 lg:grid-cols-12 gap-8">
    <div class="lg:col-span-7 space-y-4">
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div>
          <label class="block text-xs font-semibold text-slate-700 mb-1">Landlord / Owner Name</label>
          <input type="text" id="landlordName" placeholder="e.g. Robert Miller" class="w-full rounded-lg border-slate-300 border p-2.5 text-sm" />
        </div>
        <div>
          <label class="block text-xs font-semibold text-slate-700 mb-1">Tenant Full Name(s)</label>
          <input type="text" id="tenantName" placeholder="e.g. Emily Carter" class="w-full rounded-lg border-slate-300 border p-2.5 text-sm" />
        </div>
      </div>

      <div>
        <label class="block text-xs font-semibold text-slate-700 mb-1">Rental Property Full Address</label>
        <input type="text" id="propertyAddress" placeholder="e.g. 120 Maple Street, Unit 2A, Austin, TX" class="w-full rounded-lg border-slate-300 border p-2.5 text-sm" />
      </div>

      <div class="grid grid-cols-3 gap-3">
        <div>
          <label class="block text-xs font-semibold text-slate-700 mb-1">Lease Type</label>
          <select id="leaseType" class="w-full rounded-lg border-slate-300 border p-2.5 text-sm">
            <option value="Fixed-Term (1 Year)" selected>Fixed-Term</option>
            <option value="Month-to-Month">Month-to-Month</option>
          </select>
        </div>
        <div>
          <label class="block text-xs font-semibold text-slate-700 mb-1">Start Date</label>
          <input type="date" id="startDate" value="2026-12-01" class="w-full rounded-lg border-slate-300 border p-2.5 text-sm" />
        </div>
        <div>
          <label class="block text-xs font-semibold text-slate-700 mb-1">End Date</label>
          <input type="date" id="endDate" value="2027-11-30" class="w-full rounded-lg border-slate-300 border p-2.5 text-sm" />
        </div>
      </div>

      <div class="grid grid-cols-3 gap-3">
        <div>
          <label class="block text-xs font-semibold text-slate-700 mb-1">Currency</label>
          <select id="currency" class="w-full rounded-lg border-slate-300 border p-2.5 text-sm">
            <option value="$" selected>USD ($)</option>
            <option value="£">GBP (£)</option>
            <option value="€">EUR (€)</option>
            <option value="CA$">CAD (CA$)</option>
            <option value="A$">AUD (A$)</option>
          </select>
        </div>
        <div>
          <label class="block text-xs font-semibold text-slate-700 mb-1">Monthly Rent</label>
          <input type="number" id="monthlyRent" value="2100" step="50" class="w-full rounded-lg border-slate-300 border p-2.5 text-sm" />
        </div>
        <div>
          <label class="block text-xs font-semibold text-slate-700 mb-1">Security Deposit</label>
          <input type="number" id="securityDeposit" value="2100" step="50" class="w-full rounded-lg border-slate-300 border p-2.5 text-sm" />
        </div>
      </div>

      <div class="grid grid-cols-2 gap-4">
        <div>
          <label class="block text-xs font-semibold text-slate-700 mb-1">Rent Due Day of Month</label>
          <select id="dueDay" class="w-full rounded-lg border-slate-300 border p-2.5 text-sm">
            <option value="1st" selected>1st of the Month</option>
            <option value="5th">5th of the Month</option>
            <option value="15th">15th of the Month</option>
          </select>
        </div>
        <div>
          <label class="block text-xs font-semibold text-slate-700 mb-1">Pet Policy</label>
          <select id="petsAllowed" class="w-full rounded-lg border-slate-300 border p-2.5 text-sm">
            <option value="No pets are permitted on the Premises without prior written consent" selected>No Pets Allowed</option>
            <option value="Household pets are permitted subject to Landlord approval">Pets Allowed</option>
          </select>
        </div>
      </div>
    </div>

    <div class="lg:col-span-5 bg-slate-50 rounded-xl p-6 border border-slate-200 flex flex-col justify-between">
      <div>
        <span class="text-xs font-bold uppercase tracking-wider text-emerald-600">Lease Summary</span>
        <div id="previewRent" class="text-3xl font-extrabold text-slate-900 mt-1 mb-5">
          $2,100.00 / mo
        </div>

        <div class="space-y-2.5 border-t border-slate-200 pt-4 text-xs text-slate-600">
          <div class="flex justify-between"><span>Security Deposit:</span><strong id="previewDeposit" class="text-slate-900">$2,100.00</strong></div>
          <div class="flex justify-between"><span>Tenancy Term:</span><strong id="previewTerm" class="text-slate-900">Fixed-Term (1 Year)</strong></div>
          <div class="flex justify-between"><span>Pet Rule:</span><strong id="previewPets" class="text-slate-900 truncate max-w-[180px]">No Pets Allowed</strong></div>
        </div>
      </div>

      <div class="mt-8">
        <button id="downloadPdfBtn"
          class="w-full bg-emerald-600 hover:bg-emerald-700 text-white font-bold py-3.5 px-6 rounded-xl shadow-sm transition cursor-pointer">
          Download PDF Lease Agreement
        </button>
        <p class="text-xs text-center text-slate-500 mt-2">
          8 Standard Clauses + Signature Blocks • Free PDF
        </p>
      </div>
    </div>
  </div>

  <AdSlot label="Sponsored" />

  <article class="bg-white rounded-2xl border border-slate-200 p-6 md:p-10 mt-8 prose max-w-none text-slate-700 space-y-4">
    <h2 class="text-2xl font-bold text-slate-900">Key Clauses Every Residential Lease Should Include</h2>
    <p>
      A well-written rental contract protects both landlords and tenants by clearly stating the monthly rent amount, due date, security deposit rules, lease duration, and pet restrictions before keys are handed over.
    </p>
  </article>
</BaseLayout>

<script src="../scripts/leaseAgreement.js"></script>
