---
import BaseLayout from '../layouts/BaseLayout.astro';
import AdSlot from '../components/AdSlot.astro';
---

<BaseLayout
  title="Free Late Rent Notice & Past Due Reminder Generator (PDF) | LandlordFormKit"
  description="Create and download an official printable Notice of Past Due Rent PDF for late tenant payments. 100% free with no signup."
>
  <div class="text-center max-w-3xl mx-auto mb-6">
    <h1 class="text-3xl md:text-4xl font-extrabold text-slate-900 mb-3">
      Free Late Rent Notice Generator
    </h1>
    <p class="text-slate-600 text-base md:text-lg">
      Generate a professional past-due rent reminder letter with late fee breakdown ready to print or email as a PDF.
    </p>
  </div>

  <AdSlot label="Sponsored" />

  <div class="bg-white rounded-2xl shadow-sm border border-slate-200 p-6 md:p-8 grid grid-cols-1 lg:grid-cols-12 gap-8">
    <div class="lg:col-span-7 space-y-4">
      <div class="grid grid-cols-3 gap-3">
        <div>
          <label class="block text-xs font-semibold text-slate-700 mb-1">Currency</label>
          <select id="currency" class="w-full rounded-lg border-slate-300 border p-2.5 text-sm">
            <option value="$" selected>USD ($)</option>
            <option value="£">GBP (£)</option>
            <option value="€">EUR (€)</option>
            <option value="CA$">CAD (CA$)</option>
            <option value="A$">AUD (A$)</option>
          </select>
        </div>
        <div>
          <label class="block text-xs font-semibold text-slate-700 mb-1">Notice Date</label>
          <input type="date" id="noticeDate" value="2026-11-20" class="w-full rounded-lg border-slate-300 border p-2.5 text-sm" />
        </div>
        <div>
          <label class="block text-xs font-semibold text-slate-700 mb-1">Original Due Date</label>
          <input type="date" id="originalDueDate" value="2026-11-01" class="w-full rounded-lg border-slate-300 border p-2.5 text-sm" />
        </div>
      </div>

      <div class="grid grid-cols-2 gap-4">
        <div>
          <label class="block text-xs font-semibold text-slate-700 mb-1">Tenant Full Name</label>
          <input type="text" id="tenantName" placeholder="e.g. Jordan Taylor" class="w-full rounded-lg border-slate-300 border p-2.5 text-sm" />
        </div>
        <div>
          <label class="block text-xs font-semibold text-slate-700 mb-1">Rental Property Address</label>
          <input type="text" id="propertyAddress" placeholder="e.g. 88 Oak Lane, Apt 2" class="w-full rounded-lg border-slate-300 border p-2.5 text-sm" />
        </div>
      </div>

      <div class="grid grid-cols-2 gap-4">
        <div>
          <label class="block text-xs font-semibold text-slate-700 mb-1">Landlord / Manager Name</label>
          <input type="text" id="landlordName" placeholder="Landlord Name" class="w-full rounded-lg border-slate-300 border p-2.5 text-sm" />
        </div>
        <div>
          <label class="block text-xs font-semibold text-slate-700 mb-1">Landlord Phone / Email</label>
          <input type="text" id="landlordContact" placeholder="(555) 987-6543" class="w-full rounded-lg border-slate-300 border p-2.5 text-sm" />
        </div>
      </div>

      <div class="grid grid-cols-3 gap-3">
        <div>
          <label class="block text-xs font-semibold text-slate-700 mb-1">Unpaid Rent</label>
          <input type="number" id="pastDueRent" value="1800" step="50" class="w-full rounded-lg border-slate-300 border p-2.5 text-sm" />
        </div>
        <div>
          <label class="block text-xs font-semibold text-slate-700 mb-1">Late Fee</label>
          <input type="number" id="lateFee" value="75" step="10" class="w-full rounded-lg border-slate-300 border p-2.5 text-sm" />
        </div>
        <div>
          <label class="block text-xs font-semibold text-slate-700 mb-1">Days to Pay</label>
          <input type="number" id="graceDays" value="5" min="1" max="30" class="w-full rounded-lg border-slate-300 border p-2.5 text-sm" />
        </div>
      </div>
    </div>

    <div class="lg:col-span-5 bg-slate-50 rounded-xl p-6 border border-slate-200 flex flex-col justify-between">
      <div>
        <span class="text-xs font-bold uppercase tracking-wider text-rose-600">Total Past-Due Balance</span>
        <div id="totalDueDisplay" class="text-4xl font-extrabold text-slate-900 mt-1 mb-5">
          $1,875.00
        </div>

        <div class="space-y-2.5 border-t border-slate-200 pt-4 text-xs text-slate-600">
          <div class="flex justify-between"><span>Tenant:</span><strong id="previewTenant" class="text-slate-900">Tenant Name</strong></div>
          <div class="flex justify-between"><span>Original Due Date:</span><strong id="previewDueDate" class="text-slate-900">2026-11-01</strong></div>
          <div class="flex justify-between"><span>Payment Deadline:</span><strong id="previewGrace" class="text-slate-900">5 Days</strong></div>
        </div>
      </div>

      <div class="mt-8">
        <button id="downloadPdfBtn"
          class="w-full bg-emerald-600 hover:bg-emerald-700 text-white font-bold py-3.5 px-6 rounded-xl shadow-sm transition cursor-pointer">
          Download Late Rent Notice PDF
        </button>
      </div>
    </div>
  </div>

  <AdSlot label="Sponsored" />
</BaseLayout>

<script src="../scripts/lateRentNotice.js"></script>
