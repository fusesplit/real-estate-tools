---
import BaseLayout from '../layouts/BaseLayout.astro';
import AdSlot from '../components/AdSlot.astro';
---

<BaseLayout
  title="Free Rental Property Cap Rate & NOI Calculator | LandlordFormKit"
  description="Calculate Capitalization Rate (Cap Rate) and Net Operating Income (NOI) for rental properties and download a free PDF investment report."
>
  <div class="text-center max-w-3xl mx-auto mb-6">
    <h1 class="text-3xl md:text-4xl font-extrabold text-slate-900 mb-3">
      Rental Property Cap Rate & NOI Calculator
    </h1>
    <p class="text-slate-600 text-base md:text-lg">
      Evaluate any residential or commercial investment property's Net Operating Income and Cap Rate in seconds.
    </p>
  </div>

  <AdSlot label="Sponsored" />

  <div class="bg-white rounded-2xl shadow-sm border border-slate-200 p-6 md:p-8 grid grid-cols-1 lg:grid-cols-12 gap-8">
    <div class="lg:col-span-6 space-y-4">
      <div class="grid grid-cols-2 gap-4">
        <div>
          <label class="block text-xs font-semibold text-slate-700 mb-1">Currency</label>
          <select id="currency" class="w-full rounded-lg border-slate-300 border p-2.5 text-sm">
            <option value="$" selected>USD ($)</option>
            <option value="£">GBP (£)</option>
            <option value="€">EUR (€)</option>
            <option value="CA$">CAD (CA$)</option>
            <option value="A$">AUD (A$)</option>
          </select>
        </div>
        <div>
          <label class="block text-xs font-semibold text-slate-700 mb-1">Property Purchase Price</label>
          <input type="number" id="propertyPrice" value="350000" step="5000" class="w-full rounded-lg border-slate-300 border p-2.5 text-sm" />
        </div>
      </div>

      <div class="grid grid-cols-2 gap-4">
        <div>
          <label class="block text-xs font-semibold text-slate-700 mb-1">Monthly Gross Rent</label>
          <input type="number" id="monthlyRent" value="2800" step="100" class="w-full rounded-lg border-slate-300 border p-2.5 text-sm" />
        </div>
        <div>
          <label class="block text-xs font-semibold text-slate-700 mb-1">Vacancy Allowance (%)</label>
          <input type="number" id="vacancyRate" value="5" min="0" max="50" step="1" class="w-full rounded-lg border-slate-300 border p-2.5 text-sm" />
        </div>
      </div>

      <div class="grid grid-cols-3 gap-3">
        <div>
          <label class="block text-xs font-semibold text-slate-700 mb-1">Annual Taxes</label>
          <input type="number" id="propertyTax" value="4200" step="100" class="w-full rounded-lg border-slate-300 border p-2.5 text-sm" />
        </div>
        <div>
          <label class="block text-xs font-semibold text-slate-700 mb-1">Annual Insurance</label>
          <input type="number" id="insurance" value="1400" step="100" class="w-full rounded-lg border-slate-300 border p-2.5 text-sm" />
        </div>
        <div>
          <label class="block text-xs font-semibold text-slate-700 mb-1">Annual Repairs</label>
          <input type="number" id="maintenance" value="1800" step="100" class="w-full rounded-lg border-slate-300 border p-2.5 text-sm" />
        </div>
      </div>
    </div>

    <div class="lg:col-span-6 bg-slate-50 rounded-xl p-6 border border-slate-200 flex flex-col justify-between">
      <div>
        <span class="text-xs font-bold uppercase tracking-wider text-emerald-600">Property Capitalization Rate</span>
        <div id="capRateDisplay" class="text-4xl md:text-5xl font-extrabold text-slate-900 mt-1 mb-6">
          7.01%
        </div>

        <div class="space-y-2.5 border-t border-slate-200 pt-4 text-sm">
          <div class="flex justify-between">
            <span class="text-slate-600">Net Operating Income (NOI):</span>
            <strong id="noiDisplay" class="text-emerald-600">$24,520.00 / yr</strong>
          </div>
          <div class="flex justify-between">
            <span class="text-slate-600">Effective Gross Annual Rent:</span>
            <strong id="grossIncomeDisplay" class="text-slate-900">$31,920.00</strong>
          </div>
          <div class="flex justify-between">
            <span class="text-slate-600">Total Operating Expenses:</span>
            <strong id="expensesDisplay" class="text-rose-600">$7,400.00</strong>
          </div>
        </div>
      </div>

      <div class="mt-8">
        <button id="downloadPdfBtn"
          class="w-full bg-emerald-600 hover:bg-emerald-700 text-white font-bold py-3.5 px-6 rounded-xl shadow-sm transition cursor-pointer">
          Download PDF Investment Analysis
        </button>
      </div>
    </div>
  </div>

  <AdSlot label="Sponsored" />
</BaseLayout>

<script src="../scripts/capRate.js"></script>
