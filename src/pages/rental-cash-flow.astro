---
import BaseLayout from '../layouts/BaseLayout.astro';
import AdSlot from '../components/AdSlot.astro';
---

<BaseLayout
  title="Free Rental Property Cash Flow & Cash-on-Cash ROI Calculator | LandlordFormKit"
  description="Calculate monthly net cash flow, annual profit, and Cash-on-Cash ROI for any rental property investment and export a clean PDF."
>
  <div class="text-center max-w-3xl mx-auto mb-6">
    <h1 class="text-3xl md:text-4xl font-extrabold text-slate-900 mb-3">
      Rental Property Cash Flow & ROI Calculator
    </h1>
    <p class="text-slate-600 text-base md:text-lg">
      Analyze rental income, mortgage payments, and expenses to find your monthly cash flow and Cash-on-Cash return.
    </p>
  </div>

  <AdSlot label="Sponsored" />

  <div class="bg-white rounded-2xl shadow-sm border border-slate-200 p-6 md:p-8 grid grid-cols-1 lg:grid-cols-12 gap-8">
    <div class="lg:col-span-6 space-y-4">
      <div class="grid grid-cols-2 gap-4">
        <div>
          <label class="block text-xs font-semibold text-slate-700 mb-1">Currency</label>
          <select id="currency" class="w-full rounded-lg border-slate-300 border p-2.5 text-sm">
            <option value="$" selected>USD ($)</option>
            <option value="£">GBP (£)</option>
            <option value="€">EUR (€)</option>
            <option value="CA$">CAD (CA$)</option>
            <option value="A$">AUD (A$)</option>
          </select>
        </div>
        <div>
          <label class="block text-xs font-semibold text-slate-700 mb-1">Purchase Price</label>
          <input type="number" id="purchasePrice" value="300000" step="5000" class="w-full rounded-lg border-slate-300 border p-2.5 text-sm" />
        </div>
      </div>

      <div class="grid grid-cols-3 gap-3">
        <div>
          <label class="block text-xs font-semibold text-slate-700 mb-1">Down Payment</label>
          <input type="number" id="downPayment" value="60000" step="1000" class="w-full rounded-lg border-slate-300 border p-2.5 text-sm" />
        </div>
        <div>
          <label class="block text-xs font-semibold text-slate-700 mb-1">Closing Costs</label>
          <input type="number" id="closingCosts" value="6000" step="500" class="w-full rounded-lg border-slate-300 border p-2.5 text-sm" />
        </div>
        <div>
          <label class="block text-xs font-semibold text-slate-700 mb-1">Mortgage APR (%)</label>
          <input type="number" id="interestRate" value="6.8" step="0.1" class="w-full rounded-lg border-slate-300 border p-2.5 text-sm" />
        </div>
      </div>

      <div class="grid grid-cols-2 gap-4">
        <div>
          <label class="block text-xs font-semibold text-slate-700 mb-1">Gross Monthly Rent</label>
          <input type="number" id="monthlyRent" value="2750" step="50" class="w-full rounded-lg border-slate-300 border p-2.5 text-sm" />
        </div>
        <div>
          <label class="block text-xs font-semibold text-slate-700 mb-1">Monthly Expenses (Tax/Ins/Maint)</label>
          <input type="number" id="monthlyExpenses" value="750" step="50" class="w-full rounded-lg border-slate-300 border p-2.5 text-sm" />
        </div>
      </div>
    </div>

    <div class="lg:col-span-6 bg-slate-50 rounded-xl p-6 border border-slate-200 flex flex-col justify-between">
      <div>
        <span class="text-xs font-bold uppercase tracking-wider text-emerald-600">Net Monthly Cash Flow</span>
        <div id="monthlyCashFlowDisplay" class="text-4xl md:text-5xl font-extrabold text-emerald-600 mt-1 mb-6">
          $435.38 / mo
        </div>

        <div class="space-y-2.5 border-t border-slate-200 pt-4 text-sm">
          <div class="flex justify-between">
            <span class="text-slate-600">Cash-on-Cash Return (ROI):</span>
            <strong id="cocReturnDisplay" class="text-emerald-600">7.92%</strong>
          </div>
          <div class="flex justify-between">
            <span class="text-slate-600">Annual Net Cash Flow:</span>
            <strong id="annualCashFlowDisplay" class="text-slate-900">$5,224.56</strong>
          </div>
          <div class="flex justify-between">
            <span class="text-slate-600">Monthly Mortgage (30-Yr P&I):</span>
            <strong id="mortgageDisplay" class="text-slate-900">$1,564.62</strong>
          </div>
          <div class="flex justify-between">
            <span class="text-slate-600">Total Cash Invested:</span>
            <strong id="cashInvestedDisplay" class="text-slate-900">$66,000.00</strong>
          </div>
        </div>
      </div>

      <div class="mt-8">
        <button id="downloadPdfBtn"
          class="w-full bg-emerald-600 hover:bg-emerald-700 text-white font-bold py-3.5 px-6 rounded-xl shadow-sm transition cursor-pointer">
          Download Cash Flow Analysis PDF
        </button>
      </div>
    </div>
  </div>

  <AdSlot label="Sponsored" />
</BaseLayout>

<script src="../scripts/rentalCashFlow.js"></script>
