---
import BaseLayout from '../layouts/BaseLayout.astro';
import AdSlot from '../components/AdSlot.astro';
---

<BaseLayout
  title="Free Tenant Rental Application Form Generator (PDF) | LandlordFormKit"
  description="Generate a clean, printable tenant rental application PDF with employment, income, rental history, and background check authorization."
>
  <div class="text-center max-w-3xl mx-auto mb-6">
    <h1 class="text-3xl md:text-4xl font-extrabold text-slate-900 mb-3">
      Free Tenant Rental Application Form
    </h1>
    <p class="text-slate-600 text-base md:text-lg">
      Pre-fill property details or generate a blank printable screening application PDF for prospective tenants.
    </p>
  </div>

  <AdSlot label="Sponsored" />

  <div class="bg-white rounded-2xl shadow-sm border border-slate-200 p-6 md:p-8 max-w-4xl mx-auto space-y-5">
    <div>
      <label class="block text-xs font-semibold text-slate-700 mb-1">Rental Property Address</label>
      <input type="text" id="propertyAddress" placeholder="e.g. 450 Pine Avenue, Apt 3C" class="w-full rounded-lg border-slate-300 border p-2.5 text-sm" />
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
      <div>
        <label class="block text-xs font-semibold text-slate-700 mb-1">Applicant Name (Optional)</label>
        <input type="text" id="applicantName" placeholder="Leave blank for paper form" class="w-full rounded-lg border-slate-300 border p-2.5 text-sm" />
      </div>
      <div>
        <label class="block text-xs font-semibold text-slate-700 mb-1">Phone Number</label>
        <input type="text" id="applicantPhone" placeholder="(555) 234-5678" class="w-full rounded-lg border-slate-300 border p-2.5 text-sm" />
      </div>
      <div>
        <label class="block text-xs font-semibold text-slate-700 mb-1">Email Address</label>
        <input type="email" id="applicantEmail" placeholder="applicant@email.com" class="w-full rounded-lg border-slate-300 border p-2.5 text-sm" />
      </div>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      <div>
        <label class="block text-xs font-semibold text-slate-700 mb-1">Current Address</label>
        <input type="text" id="currentAddress" placeholder="Current street address" class="w-full rounded-lg border-slate-300 border p-2.5 text-sm" />
      </div>
      <div>
        <label class="block text-xs font-semibold text-slate-700 mb-1">Current Landlord Name & Phone</label>
        <input type="text" id="currentLandlord" placeholder="Reference contact" class="w-full rounded-lg border-slate-300 border p-2.5 text-sm" />
      </div>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
      <div>
        <label class="block text-xs font-semibold text-slate-700 mb-1">Current Employer</label>
        <input type="text" id="employerName" placeholder="Company name" class="w-full rounded-lg border-slate-300 border p-2.5 text-sm" />
      </div>
      <div>
        <label class="block text-xs font-semibold text-slate-700 mb-1">Job Title</label>
        <input type="text" id="jobTitle" placeholder="Position" class="w-full rounded-lg border-slate-300 border p-2.5 text-sm" />
      </div>
      <div>
        <label class="block text-xs font-semibold text-slate-700 mb-1">Gross Monthly Income ($)</label>
        <input type="number" id="monthlyIncome" placeholder="5500" class="w-full rounded-lg border-slate-300 border p-2.5 text-sm" />
      </div>
    </div>

    <div class="grid grid-cols-2 gap-4">
      <div>
        <label class="block text-xs font-semibold text-slate-700 mb-1">Desired Move-In Date</label>
        <input type="date" id="moveInDate" class="w-full rounded-lg border-slate-300 border p-2.5 text-sm" />
      </div>
      <div>
        <label class="block text-xs font-semibold text-slate-700 mb-1">Total Occupants</label>
        <input type="number" id="occupants" value="1" min="1" class="w-full rounded-lg border-slate-300 border p-2.5 text-sm" />
      </div>
    </div>

    <div class="pt-4">
      <button id="downloadPdfBtn"
        class="w-full bg-emerald-600 hover:bg-emerald-700 text-white font-bold py-3.5 px-6 rounded-xl shadow-sm transition cursor-pointer">
        Download Printable Rental Application PDF
      </button>
      <p class="text-xs text-center text-slate-500 mt-2">
        Includes Screening Authorization Clause • 100% Free
      </p>
    </div>
  </div>

  <AdSlot label="Sponsored" />
</BaseLayout>

<script src="../scripts/rentalApplication.js"></script>
